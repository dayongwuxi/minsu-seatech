# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会提交。
# docker compose 会自动读取本目录的 .env，注入到 backend 容器环境变量。

# Ollama Cloud LLM 网关：从 https://ollama.com 账户创建 API Key。留空=AI 功能禁用。
OLLAMA_API_KEY=

# Stripe 聚合支付（留空=Mock 模拟支付）
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# LinkTrust Pay 跳转支付（wechatpay/alipay/unionpay；留空=渠道禁用）
# 商户后台 http://pay.linktrust-pay.com 需配置決済結果通知URL:
#   https://seabnb.axionintell.com/api/payments/linktrust/callback
# LINKTRUST_MER_ID=

# 站点结算货币（报价/下单/扣款统一使用；默认 cny，接 LinkTrust 需 jpy）
# 历史变量名 STRIPE_CURRENCY 仍兜底兼容
# PAYMENT_CURRENCY=jpy
